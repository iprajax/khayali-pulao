<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet is used only for things the user switches on: the one-time download of the on-device
         AI model (huggingface.co, via Android's DownloadManager), the optional read-only Kite MCP
         connection (mcp.kite.trade), and optional web lookups (DuckDuckGo search, Yahoo Finance quotes).
         No analytics, no ads, no upload of anything read from the screen. Enforced by OnDeviceOnlyTest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <queries>
        <package android:name="com.zerodha.kite3" />
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- GPU inference for the on-device model (LiteRT-LM). Optional: falls back to CPU. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-car.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Kite OAuth return: the HTTPS callback page opens khayalipulao://kite/callback -->
        <activity
            android:name=".ai.KiteCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="khayalipulao" android:host="kite" android:path="/callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ai.ChatActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="Ask Khayali Pulao"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ai.MemoryActivity"
            android:exported="false"
            android:label="Memory" />

        <activity
            android:name=".ai.ArtifactsActivity"
            android:exported="false"
            android:label="Models &amp; data" />

        <activity
            android:name=".DemoActivity"
            android:exported="false"
            android:label="Khayali Pulao demo" />

        <!-- Serves only the share image from cache/share, read-only, via a one-time URI grant. -->
        <provider
            android:name=".ai.ShareProvider"
            android:authorities="com.khayali.pulao.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".KhayaliService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
